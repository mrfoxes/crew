#!/bin/sh
# crew: coding agents working side by side in panes the owner can see, iTerm2
# or tmux, talking through one numbered stream of messages in .crew/.
set -eu

# Follow the symlink from ~/.local/bin back to the checkout.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
    esac
done
CREW_HOME=$(cd "$(dirname "$self")/.." && pwd)

. "$CREW_HOME/lib/store.sh"
. "$CREW_HOME/lib/archive.sh"
. "$CREW_HOME/lib/kinds.sh"
. "$CREW_HOME/lib/claims.sh"
. "$CREW_HOME/lib/term.sh"
. "$CREW_HOME/lib/layout.sh"
. "$CREW_HOME/lib/clones.sh"
. "$CREW_HOME/lib/land.sh"
. "$CREW_HOME/lib/panes.sh"
. "$CREW_HOME/lib/gate.sh"
. "$CREW_HOME/lib/screen.sh"
. "$CREW_HOME/lib/context.sh"
. "$CREW_HOME/lib/doctor.sh"
. "$CREW_HOME/lib/cost.sh"
. "$CREW_HOME/lib/crewfile.sh"
. "$CREW_HOME/lib/up.sh"
. "$CREW_HOME/lib/live.sh"
. "$CREW_HOME/lib/down.sh"
. "$CREW_HOME/lib/story.sh"
. "$CREW_HOME/lib/update.sh"

usage() {
    cat <<'EOF'
usage: crew <command> [arguments]

For everyone
  help                          the protocol agents follow
  join <name> [--pane <pane> | --no-pane]
                                join the crew as <name> from this pane, or
                                with no pane: messages to you wait in the
                                stream for your next crew unread
  send <from> <to> <subject> [--message <text> | --file <file>]
                                post a message, body on stdin or given with
                                -m or -F; wakes <to>, and warns when <to> is
                                no member
  unread <name> [--peek] [--wait [seconds]]
                                the messages to <name> or all not read yet;
                                --peek keeps them unread, --wait blocks until
                                one comes (600 seconds)
  log [count] [--from <name>] [--to <name>] [--grep <text>] [--oneline]
                                the last messages, whole (5), filtered
  show <number>...              those messages, whole
  status <name> [<field>...]    write or update <name>'s status, or print it
  report <name>                 write <name>'s report, text on stdin
  board [count] | --live [seconds]
                                statuses, claims, lock, latest messages, git,
                                CI, cost; --live: a line a member, redrawn
  dir                           the crew's directory
  lock <name>                   take the push lock
  unlock <name> | --force       release it
  sync <name>                   fetch origin and rebase <name>'s clean clone onto it
  land <name> -F <file> [--check <command>] [--to <member>] -- <path>...
                                land in one command: run the check, take the
                                lock, commit those paths only, rebase a clone
                                onto origin and re-run the check when origin
                                moved, push, release the lock, tell the
                                reviewer (--to, else the Crewfile's reviewer=)
                                with Pushed:

For the coordinator
  init [--home]                 make .crew/ at the root; with --home, a
                                directory under ~/.crew named after the
                                root's path: ~/.crew/-home-me-app for
                                /home/me/app
  up [<preset>] [--fresh] [--dry]
                                bring the crew of the Crewfile up, or back:
                                tabs, members, invites, layouts; an agent
                                brought back resumes its conversation, unless
                                --fresh
  down [minutes] [--archive] [--close]
                                end the crew: tell all, wait for each Done:
                                (15 minutes), say what is left, stop the
                                watch and board crew up opened; --archive
                                archives when nothing is left, --close closes
                                the panes whose agent exited
  doctor                        check what a crew needs: terminal, agents, skills, gh
  panes                         every pane, who joined it, and its kind
  cost [name...]                what the members spent: tokens, and dollars by the rates
  spawn <name> [--tab <tab> | --beside|--below|--above <member>] [--join]
        [--kind <kind>] [--clone [--cache <dir>]...] <cmd>...
                                open a pane running <cmd> for <name>: beside
                                this one, in the tab named <tab> (opened for
                                its first member), or right of, under, or
                                over <member>'s; its kind is read from <cmd>
                                unless given; with --clone, in the member's
                                own clone of the project, ../<project>-<name>,
                                --cache copying a directory the project has
  layout [<layout>] [--tab <tab>]
                                lay out a tab's panes: table, grid, main,
                                <columns>x<rows>, or rows of names (a,b / c);
                                alone, every tab by the layout it has
  move <name> --beside|--below|--above <member>
                                move <name>'s pane right of, under, or over
                                <member>'s, its agent still running
  invite <name> [seconds]       once its agent is up, tell it to join, in caveman mode
  leave <name> [--clone]        forget <name>'s pane; --clone also removes its
                                clone, when nothing is left in it
  clear <name>                  at <name>'s idle prompt, clear its agent's
                                conversation, then have it rejoin and resume
                                from its status's Next:; refused while it
                                works, a background shell runs, or a file
                                it claims changed after its status
  compact <name> [instructions] at <name>'s idle prompt, compact its agent's
                                conversation; instructions for Claude Code
  mute <name>                   wake <name> only for messages to its name
  unmute <name>                 wake it for messages to all again
  focus <name> [--zoom]         bring <name>'s pane to the front, alone in
                                its tab with --zoom; 'crew focus -' goes back
  peek <name> [lines]           what <name>'s pane shows
  poke <name> <line>            type a line into it and press Return
  key <name> <key>...           press keys: y, enter, esc, tab, up, ctrl-c, alt-m, ...
  gate <name>... [--all] [--dry]
                                approve their prompts, hold the forbidden ones;
                                --all: every member with a pane, now and later
  relay                         wake recipients for every sender, from this pane
  watch <name>... [--all] [--dry]
                                gate and relay in one pane
  story [<archive>]             the session as one document: plan, Crewfile,
                                members, stream, commits with reviews, reports
  archive                       put the session aside: stream, statuses,
                                reports, work; start the stream over
  reset                         put the whole crew aside: the session, the plan,
                                the Crewfile, the members; start as crew init
  restore [<archive>]           bring an archive back, the latest by default;
                                never its panes: crew up brings the members back
  update [--check]              say which version runs and which release is
                                the latest; without --check, install the latest
  version                       which crew this is

<name> is lower-case letters, digits, and dashes; peek, poke, key, move,
and spawn's --beside, --below, and --above also take a pane (iterm:<id>,
tmux:<id>) from 'crew panes'. 'crew <command> --help' prints that
command's entry and runs nothing.
EOF
}

# The entry of <command> in the usage: its line and the lines under it.
usage_of() {
    usage | awk -v c="$1" '
        /^  [^ ]/ { on = ($1 == c) }
        /^[^ ]/ || /^$/ { on = 0 }
        on { print }'
}

cmd=${1:-help}
[ $# -eq 0 ] || shift
# A command's --help says what it does and does nothing else.
case "${1:-}" in
-h | --help)
    entry=$(usage_of "$cmd")
    if [ -n "$entry" ]; then
        printf '%s\n' "$entry"
        exit 0
    fi
    ;;
esac
case "$cmd" in
help) cat "$CREW_HOME/share/protocol.md" ;;
init) crew_init "$@" ;;
up) crew_up "$@" ;;
down) crew_down "$@" ;;
doctor) crew_doctor "$@" ;;
dir) crew_dir "$@" ;;
join) crew_join "$@" ;;
send) crew_send "$@" ;;
unread) crew_unread "$@" ;;
log) crew_log "$@" ;;
show) crew_show "$@" ;;
status) crew_write status "$@" ;;
report) crew_write report "$@" ;;
board) crew_board "$@" ;;
lock) crew_lock "$@" ;;
unlock) crew_unlock "$@" ;;
sync) crew_sync "$@" ;;
land) crew_land "$@" ;;
panes) crew_panes "$@" ;;
cost) crew_cost "$@" ;;
spawn) crew_spawn "$@" ;;
move) crew_move "$@" ;;
layout) crew_layout "$@" ;;
invite) crew_invite "$@" ;;
leave) crew_leave "$@" ;;
mute) crew_mute "$@" ;;
unmute) crew_unmute "$@" ;;
focus) crew_focus "$@" ;;
peek) crew_peek "$@" ;;
poke) crew_poke "$@" ;;
key) crew_key "$@" ;;
gate) crew_gate "$@" ;;
relay) crew_relay "$@" ;;
watch) crew_watch "$@" ;;
story) crew_story "$@" ;;
clear) crew_clear "$@" ;;
compact) crew_compact "$@" ;;
archive) crew_archive "$@" ;;
reset) crew_reset "$@" ;;
restore) crew_restore "$@" ;;
update) crew_update "$@" ;;
version | --version) crew_version "$@" ;;
-h | --help | usage) usage ;;
*)
    usage >&2
    exit 2
    ;;
esac
